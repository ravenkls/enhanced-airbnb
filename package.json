{
  "name": "enhanced-airbnb",
  "version": "0.2.0",
  "private": true,
  "description": "Understand Airbnb prices per night, per person, and per person per night.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ravenkls/enhanced-airbnb.git"
  },
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "typecheck": "wxt prepare && tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "preview": "vite --host 127.0.0.1 --port 4173 --open /demo/"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "jsdom": "30.1.3",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wxt": "0.21.5"
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  }
}
